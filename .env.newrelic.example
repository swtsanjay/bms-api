# Enable only in environments that should report telemetry.
NEW_RELIC_ENABLED=false

# Use a different name for each environment to keep telemetry separated.
NEW_RELIC_APP_NAME=BMS API - Local
NEW_RELIC_LICENSE_KEY=replace-with-your-new-relic-license-key

# Agent diagnostics go to container/process logs.
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=info

# Distributed traces are enabled by default in newrelic.cjs.
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Opt in only if New Relic should ingest application logs. Keep this disabled
# when another log forwarder is already configured to avoid duplicate billing.
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=2000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=false
